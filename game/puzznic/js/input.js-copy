// Управление клавиатурой
let inputGame = null;

function initInput(game) {
    inputGame = game;
    
    window.addEventListener('keydown', (e) => {
        // Предотвращаем прокрутку страницы
        if (e.key === 'ArrowUp' || e.key === 'ArrowDown' || 
            e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
            e.preventDefault();
        }
        
        // Ctrl нажат - сразу захватываем блок под курсором
        if (e.key === 'Control') {
            e.preventDefault();
            game.setCtrlPressed(true);
        }
        
        // Движение курсора (без Ctrl)
        if (!e.ctrlKey && game.heldBlock === null) {
            switch(e.key) {
                case 'ArrowLeft':
                    game.moveCursor(-1, 0);
                    break;
                case 'ArrowRight':
                    game.moveCursor(1, 0);
                    break;
                case 'ArrowUp':
                    game.moveCursor(0, -1);
                    break;
                case 'ArrowDown':
                    game.moveCursor(0, 1);
                    break;
            }
        }
        
        // С Ctrl - перемещение удерживаемого блока
        if (e.ctrlKey && game.heldBlock !== null) {
            switch(e.key) {
                case 'ArrowLeft':
                    e.preventDefault();
                    game.tryMoveHeldBlock(-1);
                    break;
                case 'ArrowRight':
                    e.preventDefault();
                    game.tryMoveHeldBlock(1);
                    break;
            }
        }
        
        // Перезапуск уровня (R)
        if (e.key === 'r' || e.key === 'R') {
            e.preventDefault();
            game.resetLevel();
        }
    });
    
    window.addEventListener('keyup', (e) => {
        if (e.key === 'Control') {
            game.setCtrlPressed(false);
        }
    });
    
    // Предотвращаем контекстное меню
    window.addEventListener('contextmenu', (e) => {
        e.preventDefault();
    });
}