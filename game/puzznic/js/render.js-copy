// Эмодзи для блоков
const blockEmojis = {
    '-': '🧱',
    '~': '🔄',
    '|': '🔃',
    'E': '⛄',
    'G': '🦊',
    'B': '🔵',
    'P': '🟣',
    'X': '🟡',
    'C': '🩵',
    'D': '🔴',
    'T': '🟤',
    ' ': '⬛'
};

const blockColors = {
    '~': '#ff9800',
    '|': '#ff5722',
    'E': '#4caf50',
    'G': '#8bc34a',
    'B': '#2196f3',
    'P': '#9c27b0',
    'X': '#ffc107',
    'C': '#00bcd4',
    'D': '#e91e63',
    'T': '#795548'
};

// Получить позицию для рендера с учётом анимации
function getBlockRenderPosition(block, cellSize, offsetX, offsetY) {
    if (block.isMoving) {
        const t = block.progress;
        const eased = 1 - Math.pow(1 - t, 2);
        const x = block.startX + (block.targetX - block.startX) * eased;
        const y = block.startY + (block.targetY - block.startY) * eased;
        return { px: offsetX + x * cellSize, py: offsetY + y * cellSize };
    }
    return { px: offsetX + block.x * cellSize, py: offsetY + block.y * cellSize };
}

function drawGrid(ctx, grid, rows, cols, cellSize, offsetX, offsetY, movingBlocks = []) {
    ctx.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);
    
    // Сначала рисуем статические блоки (фон, стены, цветные блоки)
    for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
            const cell = grid[y][x];
            const px = offsetX + x * cellSize;
            const py = offsetY + y * cellSize;
            
            // Пропускаем движущиеся блоки (они рисуются отдельно)
            const isMovingBlock = movingBlocks.some(b => !b.isMoving && b.x === x && b.y === y);
            if (isMovingBlock) continue;
            
            if (cell === '-') {
                ctx.fillStyle = '#0a0a1a';
                ctx.fillRect(px, py, cellSize, cellSize);
                
                ctx.font = `${cellSize * 0.95}px "Segoe UI Emoji", "Apple Color Emoji", "Noto Color Emoji", sans-serif`;
                ctx.fillStyle = '#c47a3a';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('🧱', px + cellSize / 2, py + cellSize / 2);
            } 
            else if (cell === ' ') {
                ctx.fillStyle = '#0a0a1a';
                ctx.fillRect(px, py, cellSize, cellSize);
            }
            else if (cell !== '~' && cell !== '|') {
                ctx.fillStyle = blockColors[cell] || '#0a0a1a';
                ctx.fillRect(px, py, cellSize, cellSize);
                
                const emoji = blockEmojis[cell] || '❓';
                ctx.font = `${cellSize * 0.6}px "Segoe UI Emoji", "Apple Color Emoji", sans-serif`;
                ctx.fillStyle = '#fff';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(emoji, px + cellSize / 2, py + cellSize / 2);
            }
        }
    }
    
    // Рисуем движущиеся блоки поверх (с анимацией)
    for (const block of movingBlocks) {
        const { px, py } = getBlockRenderPosition(block, cellSize, offsetX, offsetY);
        
        ctx.fillStyle = blockColors[block.type] || '#0a0a1a';
        ctx.fillRect(px, py, cellSize, cellSize);
        
        const emoji = blockEmojis[block.type] || '❓';
        ctx.font = `${cellSize * 0.6}px "Segoe UI Emoji", "Apple Color Emoji", sans-serif`;
        ctx.fillStyle = '#fff';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(emoji, px + cellSize / 2, py + cellSize / 2);
    }
}

function drawCursor(ctx, cursorX, cursorY, cellSize, offsetX, offsetY, isHolding = false) {
    const px = offsetX + cursorX * cellSize;
    const py = offsetY + cursorY * cellSize;
    const padding = isHolding ? 4 : 2;
    const size = cellSize - (padding * 2);
    
    ctx.save();
    
    if (isHolding) {
        ctx.strokeStyle = '#ff6b6b';
        ctx.lineWidth = 4;
    } else {
        ctx.strokeStyle = '#ffd700';
        ctx.lineWidth = 3;
    }
    
    ctx.shadowBlur = 0;
    ctx.strokeRect(px + padding, py + padding, size, size);
    
    const cornerSize = 8;
    ctx.beginPath();
    ctx.moveTo(px + cornerSize, py + padding);
    ctx.lineTo(px + padding, py + padding);
    ctx.lineTo(px + padding, py + cornerSize);
    ctx.stroke();
    
    ctx.beginPath();
    ctx.moveTo(px + cellSize - cornerSize, py + padding);
    ctx.lineTo(px + cellSize - padding, py + padding);
    ctx.lineTo(px + cellSize - padding, py + cornerSize);
    ctx.stroke();
    
    ctx.beginPath();
    ctx.moveTo(px + cornerSize, py + cellSize - padding);
    ctx.lineTo(px + padding, py + cellSize - padding);
    ctx.lineTo(px + padding, py + cellSize - cornerSize);
    ctx.stroke();
    
    ctx.beginPath();
    ctx.moveTo(px + cellSize - cornerSize, py + cellSize - padding);
    ctx.lineTo(px + cellSize - padding, py + cellSize - padding);
    ctx.lineTo(px + cellSize - padding, py + cellSize - cornerSize);
    ctx.stroke();
    
    ctx.restore();
}

function drawHeldBlock(ctx, heldBlock, cellSize, offsetX, offsetY) {
    const px = offsetX + heldBlock.x * cellSize;
    const py = offsetY + heldBlock.y * cellSize;
    
    ctx.save();
    ctx.globalAlpha = 0.5;
    ctx.fillStyle = blockColors[heldBlock.type] || '#fff';
    ctx.fillRect(px, py, cellSize, cellSize);
    
    const emoji = blockEmojis[heldBlock.type] || '❓';
    ctx.font = `${cellSize * 0.6}px "Segoe UI Emoji", "Apple Color Emoji", sans-serif`;
    ctx.fillStyle = '#fff';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(emoji, px + cellSize / 2, py + cellSize / 2);
    
    ctx.globalAlpha = 0.8;
    ctx.strokeStyle = '#ffd700';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(px + 5, py + cellSize / 2);
    ctx.lineTo(px - 8, py + cellSize / 2);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(px + cellSize - 5, py + cellSize / 2);
    ctx.lineTo(px + cellSize + 8, py + cellSize / 2);
    ctx.stroke();
    
    ctx.restore();
}