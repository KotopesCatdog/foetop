# Включаем модуль перезаписи (нужен для некоторых настроек)
RewriteEngine On

# === НАСТРОЙКИ ДЛЯ building.json ===
<Files "building.json">
    # Разрешаем загрузку с любых доменов (CORS)
    Header set Access-Control-Allow-Origin "*"
    
    # Явно указываем тип содержимого
    Header set Content-Type "application/json"
    
    # Разрешаем кэширование на 1 час (снизит нагрузку)
    Header set Cache-Control "public, max-age=3600"
</Files>

# === ВКЛЮЧАЕМ СЖАТИЕ GZIP ===
<IfModule mod_deflate.c>
    # Сжимаем JSON файлы
    AddOutputFilterByType DEFLATE application/json
    
    # Для старых браузеров
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript
</IfModule>

# === ОПЦИОНАЛЬНО: настройка кэширования для статики ===
<IfModule mod_expires.c>
    ExpiresActive On
    # JSON файлы кэшируем на 1 час
    ExpiresByType application/json "access plus 1 hour"
</IfModule>

<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddEncoding gzip .wasm
</IfModule>
AddType application/wasm .wasm